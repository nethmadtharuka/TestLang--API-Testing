package com.testlang;

import java_cup.runtime.*;

// Terminals (tokens from your lexer.l file)
terminal WORD;

// Non-Terminals (grammar rule names)
// Notice there is NO type here. It will default to Object, which is correct.
non terminal Start;

// Precedence Declarations (if any)
// none for now

// The Grammar Rules
Start ::=
        /* Rule for one or more WORDs */
        WORD Start
        |
        /* Rule for empty input (optional) */
        ;