package com.testlang;

import java_cup.runtime.*;

// Define terminals (tokens from the lexer)
terminal CONFIG, LET, TEST, GET, POST, PUT, DELETE, EXPECT, STATUS, HEADER, BODY, CONTAINS, BASE_URL;
terminal String IDENT, STRING, NUMBER;
terminal EQ, LBRACE, RBRACE, SEMI;

// Define non-terminals AND the Java object they will return
non terminal ProgramNode        program;
non terminal StatementNode      statement;
non terminal LetNode            let_decl;
non terminal TestNode           test_block;
non terminal ConfigNode         config_block;
non terminal java.util.List     test_commands_list;
non terminal TestCommandNode    test_command;
non terminal RequestNode        request;
non terminal ExpectNode         assertion;

// The grammar rules start here
program ::=
    program:p statement:s
    {:
        p.addStatement(s);
        RESULT = p;
    :}
    |
    /* empty */
    {:
        RESULT = new ProgramNode();
    :}
    ;

statement ::=
    let_decl:ld
    {:
        RESULT = ld;
    :}
    | test_block:tb
    {:
        RESULT = tb;
    :}
    | config_block:cb
    {:
        RESULT = cb;
    :}
    ;

let_decl ::=
    LET IDENT:name EQ STRING:val SEMI
    {:
        RESULT = new LetNode(name, val);
    :}
    |
    LET IDENT:name EQ NUMBER:val SEMI
    {:
        RESULT = new LetNode(name, val);
    :}
    ;

// Upgraded test_block rule to accept commands
test_block ::= TEST IDENT:name LBRACE test_commands_list:cmds RBRACE
    {:
        // Create a new TestNode
        TestNode testNode = new TestNode(name);
        // Add all the commands (requests/expects) from the list to the node
        if (cmds != null) {
            for (Object cmd : cmds) {
                testNode.addCommand((TestCommandNode)cmd);
            }
        }
        RESULT = testNode;
    :}
    ;

// Rule for a list of commands (or an empty list)
test_commands_list ::=
    test_commands_list:list test_command:cmd
    {:
        // Add the new command to the list and return the list
        list.add(cmd);
        RESULT = list;
    :}
    |
    /* empty */
    {:
        // Return a new, empty list
        RESULT = new java.util.ArrayList();
    :}
    ;

// Rule for a single command
test_command ::=
    request:r
    {: RESULT = r; :}
    |
    assertion:a
    {: RESULT = a; :}
    ;

// Rule for HTTP requests (POST/GET)
request ::=
    // Rule for: POST "/api/login" { body = "..."; }
    POST STRING:url LBRACE BODY EQ STRING:body SEMI RBRACE
    {:
        RESULT = new RequestNode("POST", url, body);
    :}
    |
    // Rule for: GET "/api/users/1";
    GET STRING:url SEMI
    {:
        RESULT = new RequestNode("GET", url, null);
    :}
    |
    // Rule for: PUT "/api/update" { body = "..."; }
    PUT STRING:url LBRACE BODY EQ STRING:body SEMI RBRACE
    {:
        RESULT = new RequestNode("PUT", url, body);
    :}
    |
    // Rule for: DELETE "/api/delete/1";
    DELETE STRING:url SEMI
    {:
        RESULT = new RequestNode("DELETE", url, null);
    :}
    ;

// Rule for assertions (expect)
assertion ::=
    // Rule for: expect status = 200;
    EXPECT STATUS EQ NUMBER:code SEMI
    {:
        RESULT = new ExpectNode("status", code);
    :}
    |
    // Rule for: expect body contains "token";
    EXPECT BODY CONTAINS STRING:content SEMI
    {:
        RESULT = new ExpectNode("body", "contains", content);
    :}
    |
    // Rule for: expect header "Content-Type" contains "json";
    EXPECT HEADER STRING:headerName CONTAINS STRING:content SEMI
    {:
        RESULT = new ExpectNode("header", headerName, content);
    :}
    ;

config_block ::= CONFIG LBRACE BASE_URL EQ STRING:url SEMI RBRACE
    {:
        RESULT = new ConfigNode(url);
    :}
    ;