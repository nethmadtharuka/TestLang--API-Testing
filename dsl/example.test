config {
    base_url = "http://localhost:8080";
}

let user = "admin";

test Login {
    post "/api/login" {
        body = "{ \"username\": \"$user\", \"password\": \"1234\" }";
    }

    expect status = 200;
    expect header "Content-Type" contains "json";
    expect body contains "\"token\":";
}